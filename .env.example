# ===========================================================================
# BLUE ID BACKEND — ENVIRONMENT TEMPLATE
# ---------------------------------------------------------------------------
# Copy to .env.local (development) or .env (deployed) and fill in.
#   cp .env.example .env.local
# This template is the ONLY env file that is committed. It must never hold
# real credentials.
# ===========================================================================

# --- Application ------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=Blue ID
APP_BASE_URL=http://localhost:5000
WEB_PORTAL_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false

# --- MongoDB ----------------------------------------------------------------
# PostgreSQL, self-hosted. The register holds identity data about Nigerian
# citizens, which NITDA's National Cloud Policy requires to be stored in
# Nigeria at rest — so the database runs on the same in-country server as the
# API rather than on a managed service abroad.
#
# Local development: docker compose -f deploy/docker-compose.yml up postgres
DATABASE_URL=postgres://blueid:blueid@127.0.0.1:5432/blueid
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2
DATABASE_STATEMENT_TIMEOUT_MS=30000
# false is accepted in production only when the database is on loopback or
# the container network; a remote database must use TLS.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_PATH=

# --- Redis (Upstash) --------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_PREFIX=blueid
CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_TTL_SECONDS=120

# --- Authentication (token verification only; client owns login) ------------
# firebase | jwt | jwks | disabled
AUTH_MODE=firebase
AUTH_JWT_SECRET=
AUTH_JWKS_URI=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_UID_CLAIM=sub
AUTH_EMAIL_CLAIM=email
# Must be false in production — provision officers by invitation.
AUTH_AUTO_PROVISION=false
AUTH_REQUIRE_VERIFIED_EMAIL=true
AUTH_MAX_FAILURES_PER_WINDOW=20
SERVICE_API_KEY=

# --- Firebase (identity provider only) --------------------------------------
# Required when AUTH_MODE=firebase. The private key keeps its \n escapes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Blue ID issuance -------------------------------------------------------
BLUE_ID_PREFIX=CRS
BLUE_ID_SEGMENT=BLU
BLUE_ID_SEQUENCE_PADDING=4
QR_SIGNING_SECRET=
VERIFICATION_BASE_URL=https://blueid.cr.gov.ng/verify

# --- Media storage ----------------------------------------------------------
# local       images on this server's own disk (the deployment default)
# cloudinary  the managed service
#
# NITDA's National Cloud Policy places biometric and identity data in a tier
# that must be stored in Nigeria at rest. A passport photograph tied to a NIN
# in a government identity register sits in that tier, which is why `local`
# is the default here.
MEDIA_DRIVER=local

# Absolute path, OUTSIDE the deploy directory so a release cannot wipe it.
# Must be on a volume that is backed up off this machine — a lost photograph
# cannot be regenerated, it means visiting the fisherman again.
MEDIA_ROOT=/var/lib/blueid/media

# Signs the expiring image URLs. At least 32 characters, different from every
# other secret here. The app refuses to start without it when MEDIA_DRIVER=local.
#   openssl rand -base64 48
MEDIA_URL_SECRET=

# Longest edge and JPEG quality for stored images.
MEDIA_MAX_EDGE=1024
MEDIA_JPEG_QUALITY=82

# Set this when nginx fronts the app, to the `internal` location that maps to
# MEDIA_ROOT. Node then authorises the request and hands the file to nginx to
# send, so image bytes never pass through the event loop. Leave blank and
# Node streams the file itself. See OPERATIONS.md for the nginx block.
MEDIA_XACCEL_PREFIX=

# --- Cloudinary (only needed when MEDIA_DRIVER=cloudinary, or to migrate) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=blueid
CLOUDINARY_UPLOAD_PRESET=
MAX_UPLOAD_SIZE_MB=10

# --- Brevo ------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_REPLY_TO=
EMAIL_DRY_RUN=false

# --- Offline sync & data quality --------------------------------------------
SYNC_MAX_BATCH_SIZE=200
SYNC_CONFLICT_STRATEGY=server_wins
DUPLICATE_SCORE_THRESHOLD=0.72
DUPLICATE_AUTO_FLAG=true

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
SYNC_RATE_LIMIT_MAX=60

# --- Field-level encryption -------------------------------------------------
# Required in production (32+ characters). Store in a managed secret, never here.
FIELD_ENCRYPTION_KEY=

# --- Background workers -----------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
WORKER_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=50

# --- Operations -------------------------------------------------------------
# Unlocks the detailed /health/ready body. Without it a probe sees up/down only.
HEALTH_PROBE_KEY=

# --- Local authentication ---------------------------------------------------
# AUTH_MODE=local makes this service own sign-in. AUTH_JWT_SECRET (32+ chars)
# signs the access tokens it issues and is REQUIRED in this mode.
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_FAILED_LOGINS=8
AUTH_LOCKOUT_MINUTES=15
AUTH_RESET_TOKEN_TTL_MINUTES=30

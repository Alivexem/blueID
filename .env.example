# Cross River State Blue ID & Fisheries Information Management System
#
#   cp .env.example .env.local        then fill in the values marked GENERATE
#
# Every variable below is read by src/config/index.js. Nothing here is
# decorative: the config refuses to start if a required one is missing, which
# is deliberate — a half-configured instance that boots and then fails on an
# enumerator's first upload is worse than one that refuses to start.
#
# Generate each secret separately. Reusing one for two purposes means
# compromising either compromises both:
#
#   openssl rand -base64 48

# --- Application ------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_NAME=Blue ID
API_PREFIX=/api/v1
APP_BASE_URL=http://localhost:4000
WEB_PORTAL_URL=http://localhost:3000
# Comma separated. A wildcard is refused in production.
CORS_ORIGINS=http://localhost:3000
# true only when nginx or a load balancer sits in front, so req.ip is the
# client rather than the proxy.
TRUST_PROXY=false
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# MongoDB. Production requires TLS: either mongodb+srv:// or an explicit
# tls=true, because the register carries names, dates of birth and NINs.
MONGODB_URI=mongodb://127.0.0.1:27017/blueid
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2

# --- Authentication ---------------------------------------------------------
# local     this service owns sign-in and issues its own tokens (the default)
# jwt       HS256 against a shared secret, for service-to-service tokens
# jwks      RS256 against a remote JWKS, with a pinned issuer and audience
# disabled  DEV ONLY — trusts x-debug-uid / x-debug-role headers.
#           The config refuses this in production.
AUTH_MODE=local

# Signs the access tokens this service issues. 32+ characters.
AUTH_JWT_SECRET=                        # GENERATE
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_RESET_TOKEN_TTL_MINUTES=30

# Lockout. Eight wrong passwords holds the account shut for fifteen minutes.
AUTH_MAX_FAILED_LOGINS=8
AUTH_LOCKOUT_MINUTES=15
AUTH_MAX_FAILURES_PER_WINDOW=20

# Accounts are created by invitation, never self-service. Both must stay
# false/true respectively in production; the config enforces it.
AUTH_AUTO_PROVISION=false
AUTH_REQUIRE_VERIFIED_EMAIL=true

# Only read in jwt/jwks mode. Leave blank for local.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWKS_URI=
AUTH_UID_CLAIM=sub
AUTH_EMAIL_CLAIM=email

# --- Field-level encryption -------------------------------------------------
# Encrypts the NIN at rest and keys the blind index that makes it searchable
# without decrypting. LOSING THIS MAKES EVERY STORED NIN UNREADABLE — keep a
# copy somewhere other than the server.
FIELD_ENCRYPTION_KEY=                   # GENERATE, 32+ chars

# Signs the opaque token printed as the QR code on an ID card. The token is
# never the Blue ID itself, so a card photographed by a stranger hands over
# nothing usable.
QR_SIGNING_SECRET=                      # GENERATE, 32+ chars

# --- Media (Cloudinary) -----------------------------------------------------
# All images are stored on Cloudinary. Production refuses to start without
# these: a passport photograph is required before a Blue ID can be issued, so
# an instance with nowhere to put one cannot complete a registration.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=blueid
CLOUDINARY_UPLOAD_PRESET=
MAX_UPLOAD_SIZE_MB=10

# --- Blue ID ----------------------------------------------------------------
# Produces CRS-BLU-BAK-0001.
BLUE_ID_PREFIX=CRS
BLUE_ID_SEGMENT=BLU
BLUE_ID_SEQUENCE_PADDING=4
VERIFICATION_BASE_URL=http://localhost:3000/verify

# --- Email (Brevo) ----------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@crossriverstate.gov.ng
BREVO_SENDER_NAME=Cross River State Blue ID
BREVO_REPLY_TO=
# true logs the message instead of sending it. Useful locally; never in
# production, where an officer would never receive their invitation.
EMAIL_DRY_RUN=true

# --- Duplicate detection (concept note §10) ---------------------------------
# Score at or above which a record is flagged for administrative review.
# Flagged, never auto-merged — the brief is explicit about that.
DUPLICATE_SCORE_THRESHOLD=0.82
DUPLICATE_AUTO_FLAG=true

# --- Offline sync -----------------------------------------------------------
SYNC_MAX_BATCH_SIZE=500
SYNC_RATE_LIMIT_MAX=60
# How a client edit that collides with a newer server edit is settled.
SYNC_CONFLICT_STRATEGY=SERVER_WINS

# --- Background jobs --------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=5000
WORKER_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=20

# --- Cache ------------------------------------------------------------------
# In-process. There is no Redis: it held personal data outside Nigeria.
# The consequence is that rate limits and the sync lock are per-process, so
# the app refuses to start a second instance in production.
CACHE_PREFIX=blueid
CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_TTL_SECONDS=120

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Operational ------------------------------------------------------------
# Guards the detailed /health/ready response and the API docs in production.
HEALTH_PROBE_KEY=                       # GENERATE
# Read-only key for other government systems (concept note §12).
SERVICE_API_KEY=                        # GENERATE
# true exposes /docs without the probe key. Leave false in production.
DOCS_PUBLIC=false

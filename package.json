{
  "name": "blueid-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cross River State Blue ID & Fisheries Information Management System \u2014 backend API",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "create:admin": "node src/scripts/createAdmin.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "node --test --test-global-setup=./test/setup/globalSetup.js --test-timeout=90000 'test/**/*.test.js'",
    "test:watch": "node --test --watch --test-global-setup=./test/setup/globalSetup.js 'test/**/*.test.js'",
    "db:indexes": "node src/scripts/syncIndexes.js",
    "db:indexes:check": "node src/scripts/syncIndexes.js --check",
    "db:migrate": "node src/scripts/migrate.js",
    "db:migrate:status": "node src/scripts/migrate.js --status",
    "db:validators": "node src/scripts/applyValidators.js",
    "deploy:db": "npm run db:indexes && npm run db:migrate",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit",
    "media:migrate": "node src/scripts/migrateMedia.js",
    "media:verify": "node src/scripts/migrateMedia.js --verify"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@upstash/redis": "^1.34.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "mongoose": "^8.9.5",
    "multer": "^2.0.1",
    "pdfkit": "^0.15.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2"
  }
}

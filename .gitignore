# ---------------------------------------------------------------------------
# Environment & secrets  — NEVER commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
.env.local
.env.development
.env.development.local
.env.staging
.env.production
.env.production.local
.env.test
.env.test.local

# Credential material
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials/
service-account*.json

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# Runtime / build output
# ---------------------------------------------------------------------------
dist/
build/
coverage/
.nyc_output/
*.pid
*.seed
*.pid.lock
.tmp/
tmp/
temp/

# Generated artefacts (exports, QR codes, backups).
#
# Anchored with a leading slash so they match ONLY at the repository root.
# A bare `storage/` also matched src/services/storage/, which silently kept
# the entire media driver out of every commit — the app did not boot from a
# fresh clone, and nothing said why.
/storage/
/uploads/
/exports/
/backups/

# ---------------------------------------------------------------------------
# Editors & OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.sample.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.eslintcache
.cache/
.npm/
FRONTEND_GUIDE.md
